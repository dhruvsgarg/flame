# Real-profiled vclock charges for sim-only costs sim can't measure
# live (FWDLLM_DESIGN.md §P). Regenerate via expt_scripts/
# profile_sim_charges.py -- hand-edit only `charge:`/`rationale:`.
drain_tail:
  _default:
    charge: true
    mean_s: 0.1011
    n: 310
    p90_s: 0.1127
    profiled_at: '2026-08-01'
    rationale: sim runs the same op under ~100 co-located trainer threads, so its
      live span is contention-inflated and folding it on the vclock injects sim-host
      noise (simulate_fwdllm.md D-18, F-1/F-20). Charged from this baseline's own
      real.
    source_runs:
    - run_20260801_005640_fwdllm_n100_smoke_syn_0_real
fedavg:
  _default:
    charge: true
    mean_s: 0.059
    n: 310
    p90_s: 0.156
    profiled_at: '2026-08-01'
    rationale: same as drain_tail -- sim's own span is contention-inflated, so the
      charge comes from this baseline's own real.
    source_runs:
    - run_20260801_005640_fwdllm_n100_smoke_syn_0_real
