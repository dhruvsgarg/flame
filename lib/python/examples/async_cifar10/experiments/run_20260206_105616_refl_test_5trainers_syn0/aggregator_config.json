{
  "taskid": "refl_test_5trainers_experiment",
  "backend": "mqtt",
  "brokers": [
    {
      "host": "localhost",
      "sort": "mqtt"
    }
  ],
  "groupAssociation": {
    "param-channel": "default"
  },
  "channels": [
    {
      "description": "Model update is sent from trainer to aggregator and vice-versa",
      "groupBy": {
        "type": "tag",
        "value": ["default"]
      },
      "name": "param-channel",
      "pair": ["trainer", "aggregator"],
      "funcTags": {
        "aggregator": ["distribute", "aggregate"],
        "trainer": ["fetch", "upload"]
      }
    }
  ],
  "selector": {
    "sort": "refl_oort",
    "kwargs": {
      "aggr_num": 3,
      "avail_priority": 2,
      "blacklist_rounds": 50,
      "pacer_step": 20,
      "pacer_delta": 5,
      "availability_trace_file": "metadata/availability_traces/synthetic_traces.yaml",
      "exploration_factor": 0.9,
      "exploration_decay": 0.98,
      "exploration_min": 0.2,
      "round_threshold": 30,
      "alpha": 2
    }
  },
  "optimizer": {
    "sort": "reflfedavg",
    "kwargs": {
      "deadline": 100,
      "stale_update": 5,
      "stale_factor": -4,
      "stale_beta": 0.9,
      "scale_coff": 10.0,
      "target_ratio": 0.8,
      "initial_deadline": 100.0
    }
  },
  "registry": {
    "sort": "mlflow",
    "uri": "tmp/mlflow"
  },
  "job": {
    "id": "test-job-refl",
    "name": "cifar10-refl-test"
  },
  "hyperparameters": {
    "rounds": 100,
    "epochs": 1,
    "batchSize": 32,
    "learningRate": 0.3,
    "aggGoal": 3,
    "trackTrainerAvail": {
      "enabled": "True",
      "type": "ORACULAR",
      "trace": "avl_events_syn_0"
    }
  },
  "dataset": "https://storage.googleapis.com/tensorflow/tf-keras-datasets/mnist.npz",
  "dependencies": ["numpy >= 1.2.0"],
  "baseModel": {
    "name": "",
    "version": 2
  },
  "realm": "cifar10-refl",
  "role": "aggregator"
}
