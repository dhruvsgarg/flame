{
  "taskid": "refl_ablation_staleness_experiment",
  "backend": "mqtt",
  "brokers": [
    {
      "host": "localhost",
      "sort": "mqtt"
    }
  ],
  "groupAssociation": {
    "param-channel": "default"
  },
  "channels": [
    {
      "description": "Model update is sent from trainer to aggregator and vice-versa",
      "groupBy": {
        "type": "tag",
        "value": ["default"]
      },
      "name": "param-channel",
      "pair": ["trainer", "aggregator"],
      "funcTags": {
        "aggregator": ["distribute", "aggregate"],
        "trainer": ["fetch", "upload"]
      }
    }
  ],
  "selector": {
    "sort": "refl_oort",
    "kwargs": {
      "aggr_num": 10,
      "avail_priority": 0,
      "blacklist_rounds": -1,
      "pacer_step": -1,
      "trainer_registry_file": "metadata/trainer_registry.yaml"
    }
  },
  "optimizer": {
    "sort": "reflfedavg",
    "kwargs": {
      "deadline": 100,
      "stale_update": 5,
      "stale_factor": -4,
      "stale_beta": 0.9,
      "scale_coff": 10.0,
      "target_ratio": 0.8
    }
  },
  "registry": {
    "sort": "mlflow",
    "uri": "tmp/mlflow"
  },
  "job": {
    "id": "ablation-staleness-only",
    "name": "REFL Staleness Handling Only"
  },
  "hyperparameters": {
    "rounds": 100,
    "epochs": 1,
    "batchSize": 32,
    "learningRate": 0.01,
    "aggGoal": 10,
    "trackTrainerAvail": {
      "enabled": "True",
      "type": "ORACULAR",
      "trace": "avl_events_syn_20"
    }
  },
  "dataset": "https://storage.googleapis.com/tensorflow/tf-keras-datasets/mnist.npz",
  "dependencies": ["numpy >= 1.2.0"],
  "baseModel": {
    "name": "",
    "version": 2
  },
  "realm": "cifar10-refl-staleness",
  "role": "aggregator"
}
