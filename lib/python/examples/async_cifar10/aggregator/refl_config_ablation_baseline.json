{
  "realm": "cifar10-refl-ablation",
  "role": "aggregator",
  "channels": [
    {
      "type": "mqtt",
      "name": "default",
      "brokerHost": "localhost",
      "pair": ["trainer"]
    }
  ],
  "selector": {
    "sort": "refl_oort",
    "kwargs": {
      "aggr_num": 10,
      "avail_priority": 0,
      "blacklist_rounds": -1,
      "pacer_step": -1,
      "exploration_factor": 0.9,
      "exploration_decay": 0.98,
      "exploration_min": 0.2
    }
  },
  "optimizer": {
    "sort": "fedavg"
  },
  "registry": {
    "sort": "mlflow",
    "uri": "tmp/mlflow"
  },
  "job": {
    "id": "ablation-baseline",
    "name": "Baseline FedAvg (no REFL features)"
  },
  "hyperparameters": {
    "rounds": 100,
    "epochs": 1,
    "batchSize": 32,
    "learningRate": 0.01,
    "lossFn": "cross_entropy"
  },
  "dataset": "cifar10"
}
