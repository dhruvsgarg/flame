{
  "realm": "cifar10-refl-ablation",
  "role": "aggregator",
  "channels": [
    {
      "type": "mqtt",
      "name": "default",
      "brokerHost": "localhost",
      "pair": ["trainer"]
    }
  ],
  "selector": {
    "sort": "refl_oort",
    "kwargs": {
      "aggr_num": 10,
      "avail_priority": 0,
      "blacklist_rounds": -1,
      "pacer_step": -1
    }
  },
  "optimizer": {
    "sort": "reflfedavg",
    "kwargs": {
      "deadline": 100,
      "stale_update": 5,
      "stale_factor": -4,
      "stale_beta": 0.9,
      "scale_coff": 10.0,
      "target_ratio": 0.8
    }
  },
  "registry": {
    "sort": "mlflow",
    "uri": "tmp/mlflow"
  },
  "job": {
    "id": "ablation-staleness-only",
    "name": "REFL Staleness Handling Only"
  },
  "hyperparameters": {
    "rounds": 100,
    "epochs": 1,
    "batchSize": 32,
    "learningRate": 0.01,
    "lossFn": "cross_entropy"
  },
  "dataset": "cifar10"
}
