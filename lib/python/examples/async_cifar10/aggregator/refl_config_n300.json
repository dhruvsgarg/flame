{
  "realm": "cifar10-refl",
  "role": "aggregator",
  "channels": [
    {
      "type": "mqtt",
      "name": "default",
      "brokerHost": "localhost",
      "pair": ["trainer"]
    }
  ],
  "selector": {
    "sort": "refl_oort",
    "kwargs": {
      "aggr_num": 30,
      "avail_priority": 2,
      "blacklist_rounds": 50,
      "pacer_step": 20,
      "pacer_delta": 5,
      "availability_trace_file": "metadata/availability_traces/mobiperf_traces.yaml",
      "avail_probability": 1.0,
      "exploration_factor": 0.9,
      "exploration_decay": 0.98,
      "exploration_min": 0.2,
      "round_threshold": 30,
      "alpha": 2,
      "clip_bound": 0.95,
      "cut_off_util": 0.95
    }
  },
  "optimizer": {
    "sort": "reflfedavg",
    "kwargs": {
      "deadline": 0,
      "stale_update": 5,
      "stale_factor": -4,
      "stale_beta": 0.9,
      "scale_coff": 10.0,
      "target_ratio": 0.8,
      "initial_deadline": 150.0
    }
  },
  "registry": {
    "sort": "mlflow",
    "uri": "tmp/mlflow"
  },
  "job": {
    "id": "refl-n300-alpha0.1",
    "name": "REFL n=300 alpha=0.1 MobiPerf"
  },
  "hyperparameters": {
    "rounds": 200,
    "epochs": 1,
    "batchSize": 32,
    "learningRate": 0.01,
    "lossFn": "cross_entropy"
  },
  "dataset": "cifar10"
}
