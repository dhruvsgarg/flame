{
  "realm": "cifar10-refl-ablation",
  "role": "aggregator",
  "channels": [
    {
      "type": "mqtt",
      "name": "default",
      "brokerHost": "localhost",
      "pair": ["trainer"]
    }
  ],
  "selector": {
    "sort": "refl_oort",
    "kwargs": {
      "aggr_num": 10,
      "avail_priority": 2,
      "blacklist_rounds": -1,
      "pacer_step": -1,
      "availability_trace_file": "metadata/availability_traces/synthetic_traces.yaml"
    }
  },
  "optimizer": {
    "sort": "fedavg"
  },
  "registry": {
    "sort": "mlflow",
    "uri": "tmp/mlflow"
  },
  "job": {
    "id": "ablation-avail-only",
    "name": "REFL Availability Selection Only"
  },
  "hyperparameters": {
    "rounds": 100,
    "epochs": 1,
    "batchSize": 32,
    "learningRate": 0.01,
    "lossFn": "cross_entropy"
  },
  "dataset": "cifar10"
}
